# SecureCloud Web — Environment configuration template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local

# The URL of the SecureCloud bot API running on the Kali Linux server.
# Replace with your actual Kali VM IP address.
VITE_API_BASE_URL=http://192.168.1.10:3000

# The shared web token configured in the bot's .env as SECURECLOUD_WEB_TOKEN.
# This is NOT a Nextcloud or database credential.
VITE_WEB_TOKEN=changeme_web_token
