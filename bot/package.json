{
  "name": "securecloud-bot",
  "version": "1.0.0",
  "description": "WhatsApp-based file management bot integrating with Nextcloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "express": "^4.21.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "webdav": "^5.7.0",
    "form-data": "^4.0.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/mime-types": "^2.1.4",
    "@types/form-data": "^2.5.0",
    "@types/jest": "^29.5.13",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
