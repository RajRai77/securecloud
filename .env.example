# =========================================================
# SecureCloud — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# =========================================================

# ---------- Nextcloud / Database ----------
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme_db_password
NEXTCLOUD_DB_ROOT_PASSWORD=changeme_db_root_password

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_admin_password

# Domain(s) Nextcloud will consider trusted, space or comma separated.
# For local dev without Caddy: localhost:8080
# For Caddy/HTTPS: your real domain (e.g. cloud.example.com)
NEXTCLOUD_DOMAIN=localhost:8080

# Host port Nextcloud is published on (without Caddy).
# Set NEXTCLOUD_PORT=80 when using the --with-proxy / Caddy profile.
NEXTCLOUD_PORT=8080

# Set to "https" once you are behind TLS (Caddy/Nginx)
NEXTCLOUD_OVERWRITE_PROTOCOL=http
NEXTCLOUD_OVERWRITE_CLI_URL=
TRUSTED_PROXIES=

# ---------- Redis ----------
REDIS_PASSWORD=changeme_redis_password

# ---------- Bot <-> Nextcloud integration ----------
# App password generated for a dedicated Nextcloud "bot" user
# (Nextcloud Settings > Security > Devices & sessions > Create new app password)
NEXTCLOUD_BOT_USERNAME=securecloud-bot
NEXTCLOUD_BOT_APP_PASSWORD=changeme_app_password
NEXTCLOUD_SHARE_PASSWORD_DEFAULT_ENABLED=true
NEXTCLOUD_SHARE_EXPIRY_DAYS=1

# ---------- WhatsApp Cloud API (Meta) ----------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=changeme_webhook_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ---------- Bot service ----------
BOT_PORT=3000
BOT_MAX_UPLOAD_MB=90
BOT_SESSION_TTL_SECONDS=1800
LOG_LEVEL=info

# Optional: comma-separated list of WhatsApp user IDs (wa_id / phone numbers in E.164 without +)
# that are allowed to use the bot. If left empty, any WhatsApp number can use the bot —
# ONLY leave empty in private/local testing. Set this before exposing the webhook publicly.
# Example: ALLOWED_WHATSAPP_NUMBERS=919876543210,14155552671
ALLOWED_WHATSAPP_NUMBERS=

# ---------- SecureCloud Web ----------
# Simple shared token for the web frontend. NOT a Nextcloud credential.
# Set to something strong and random before deploying.
SECURECLOUD_WEB_TOKEN=changeme_web_token

# The origin(s) of the frontend (Windows browser). Used for CORS.
# Set to e.g. http://192.168.1.15:5173 for Vite dev server.
# Separate multiple origins with commas.
VITE_FRONTEND_ORIGIN=http://localhost:5173
